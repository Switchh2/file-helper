<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="FileHelper.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:FileHelper"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer x:Name="LayoutViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Stretch">
        <Grid Padding="32,24" RowSpacing="24" MinWidth="600" MaxWidth="1160"
              Width="{Binding ActualWidth, ElementName=LayoutViewport}" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Uid="PageTitle" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Uid="PageSubtitle" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Padding="20" CornerRadius="12" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Uid="FolderSectionTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusText" x:Uid="FolderStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Uid="SourceChoiceHint" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="SelectFilesAction" x:Uid="SelectFilesButton" Padding="20,10" HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}" Click="SelectFiles_Click" />
                        <Button x:Name="SelectFolderAction" x:Uid="SelectFolderButton" Padding="20,10" HorizontalAlignment="Stretch"
                                Click="SelectFolder_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" CornerRadius="12" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16" ColumnSpacing="16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="{Binding Header, ElementName=FileList}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" x:Name="CategorySelector" x:Uid="CategorySelector" SelectedIndex="0" IsEnabled="False" Width="220">
                            <ComboBoxItem x:Uid="CategoryAll" />
                            <ComboBoxItem x:Uid="CategoryDocument" />
                            <ComboBoxItem x:Uid="CategoryImage" />
                            <ComboBoxItem x:Uid="CategoryMedia" />
                            <ComboBoxItem x:Uid="CategoryArchive" />
                            <ComboBoxItem x:Uid="CategoryApplication" />
                            <ComboBoxItem x:Uid="CategoryOther" />
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SortSelector" x:Uid="SortSelector" SelectedIndex="0" IsEnabled="False" Width="236">
                            <ComboBoxItem x:Uid="SortByName" />
                            <ComboBoxItem x:Uid="SortBySize" />
                            <ComboBoxItem x:Uid="SortByModified" />
                        </ComboBox>
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,1" Padding="20,10,36,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="FileNameColumn" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" x:Uid="FileSizeColumn" FontSize="12" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" x:Uid="FileModifiedColumn" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <ListView x:Name="FileList" x:Uid="FileList" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="False"
                                  Padding="8,4,24,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <!-- The file count is displayed in the fixed toolbar. -->
                            <ListView.HeaderTemplate><DataTemplate><Grid Height="0" /></DataTemplate></ListView.HeaderTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,12" />
                                    <Setter Property="MinHeight" Value="48" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:FileItem">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <CheckBox MinWidth="24" MinHeight="32" VerticalAlignment="Center"
                                                      IsChecked="{x:Bind IsIncluded, Mode=OneWay}" Tag="{x:Bind}"
                                                      Click="FileIncluded_Click" AutomationProperties.Name="{x:Bind Name}"
                                                      ToolTipService.ToolTip="{x:Bind Name}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ModifiedText}"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" Spacing="12" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="EmptyTitle" x:Uid="EmptyListTitle" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock x:Name="EmptyHint" x:Uid="EmptyListHint" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="3" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="SelectionSummary" TextWrapping="Wrap" />
                            <TextBlock x:Uid="InclusionHint" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Uid="FilterNotice" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="PreviewButton" x:Uid="PreviewButton" IsEnabled="False"
                                        Click="Preview_Click" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="ClearSelectionButton" x:Uid="ClearSelectionButton" IsEnabled="False"
                                        Click="ClearSelection_Click" />
                                <Button x:Name="ResultsButton" x:Uid="ResultsButton" IsEnabled="False" Click="Results_Click" />
                                <Button x:Name="CancelAnalysisButton" x:Uid="CancelAnalysisButton" Visibility="Collapsed" Click="CancelAnalysis_Click" />
                            </StackPanel>
                            <TextBlock x:Name="AnalysisStatus" TextWrapping="Wrap" />
                            <TextBlock x:Uid="PreviewLocalOnly" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="ReadOnlyNote" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
